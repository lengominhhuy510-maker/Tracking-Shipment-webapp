# Template dev/test sạch, không chứa secret; nguồn chuẩn: Interface-Contract v0.9.9 §7.
# Cách dùng khuyến nghị: copy file này thành .env rồi tự điền các secret bên dưới.
# .env.devtest là file key thật legacy/user-owned; worker không đọc hoặc ghi đè file đó.

# ============ Core ============
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/shipment_demo
REDIS_URL=redis://redis:6379/0
APP_PORT=1476
APP_BASE_URL=http://localhost:1476
DOMAIN=

# ============ LLM (OpenAI-compatible, §3.4) ============
LLM_BASE_URL=                       # credential/config riêng — tự điền
LLM_API_KEY=                        # secret — tự điền
LLM_MODEL=                          # model endpoint hỗ trợ — tự điền

# ============ Nguồn dữ liệu ============
AISSTREAM_API_KEY=                  # secret — tự điền khi chạy live
# Dev/test override có chủ đích: replay để deterministic, không cần key/tàu thật.
# Production/live đổi thành AIS_MODE=live (default canonical của IC§7 là live).
AIS_MODE=replay
STORMGLASS_API_KEY=                 # secret — tự điền khi smoke tide thật
SEARCH_API_PROVIDER=tavily
SEARCH_API_KEY=                     # secret — tự điền khi smoke research thật
WPI_DATA_PATH=/app/data/wpi_ports.csv
# Open-Meteo không cần key.

# ============ Auth (§3.8) ============
GOOGLE_CLIENT_ID=                   # credential — tự điền
GOOGLE_CLIENT_SECRET=               # secret — tự điền
MICROSOFT_CLIENT_ID=                # credential — tự điền
MICROSOFT_CLIENT_SECRET=            # secret — tự điền
SESSION_JWT_SECRET=                 # secret ký JWT — tự điền
SESSION_JWT_EXPIRE_HOURS=72
COOKIE_SECURE=false

# ============ Email Agent (§7.4) ============
DELEGATE_MAILBOX_IMAP_HOST=         # cấu hình mailbox — tự điền
DELEGATE_MAILBOX_USER=              # credential — tự điền
DELEGATE_MAILBOX_PASSWORD=          # secret/app password — tự điền
EMAIL_POLL_INTERVAL_MINUTES=5
# Allowlist domain hãng tàu; placeholder 5 hãng demo theo IC§7.
CARRIER_EMAIL_DOMAINS=maersk.com,msc.com,one-line.com,wanhai.com,evergreen-line.com
INTERNAL_FORWARDER_EMAILS=          # comma-separated email đầy đủ — tự điền
AUTO_FORWARD_RECIPIENTS=            # whitelist người nhận — tự điền

# ============ Hệ số ETA Engine (§6.3) ============
SOG_MIN_KNOT=1.5
ETA_DEVIATION_THRESHOLD_PCT=10
CURRENT_AGAINST_THRESHOLD_KN=1.0
CURRENT_AGAINST_PENALTY_PCT=8
WIND_AGAINST_THRESHOLD_KN=25
WIND_AGAINST_PENALTY_PCT=5
AVG_SOG_WINDOW_MSGS=10
ETA_RECOMPUTE_DEBOUNCE_SECONDS=60
ETA_HISTORY_MIN_DELTA_MINUTES=15
ARRIVAL_RADIUS_KM=5
TIDAL_WINDOW_HOURS=2

# ============ Nhịp poll ============
WEATHER_POLL_HOURS=6
TIDE_POLL_HOURS=12
RESEARCH_CADENCE_HOURS=12
TRAIL_SNAPSHOT_HOURS=6
AIS_RESUBSCRIBE_POLL_SECONDS=60

# ============ Node playwright-mcp ============
SCRAPE_REST_PORT=3000
MCP_SSE_PORT=3001
SCRAPE_CONCURRENCY=2
SCRAPE_JOB_TIMEOUT_SECONDS=90

# ============ Dev seed vessel ============
# Luồng thật: user chỉ nhập vessel_name + voyage; IMO Resolver tìm IMO/MMSI.
DEV_SEED_VESSEL_NAME=               # bắt buộc nếu muốn seed tàu thật
DEV_SEED_VESSEL_VOYAGE=             # bắt buộc nếu muốn seed tàu thật
DEV_SEED_VESSEL_IMO=                # tùy chọn shortcut, 7 digits
DEV_SEED_VESSEL_MMSI=               # tùy chọn shortcut, 9 digits
